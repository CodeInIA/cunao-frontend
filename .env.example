# =================================================================
# VARIABLES DE ENTORNO - FRONTEND (Cuñadismo Ilustrado)
# Copia este archivo como .env y completa con tus valores reales
# =================================================================

# URL de la API del backend
VITE_API_URL=http://localhost:3001/api

# Clave pública de Stripe (OBLIGATORIO - Obtener de https://stripe.com)
VITE_STRIPE_PUBLIC_KEY=pk_test_tu_clave_publica_stripe

# Configuraciones de la aplicación
VITE_APP_NAME=Cuñadismo Ilustrado
VITE_APP_DESCRIPTION=La tienda más cuñao de España
VITE_APP_URL=http://localhost:5174

# Configuraciones de moneda y envío
VITE_CURRENCY=EUR
VITE_DEFAULT_SHIPPING_COST=5.99

# Configuraciones de SEO
VITE_APP_KEYWORDS=camisetas españa, humor español, cuñadismo, ropa divertida
VITE_APP_AUTHOR=Cuñadismo Ilustrado

# URLs de redes sociales
VITE_INSTAGRAM_URL=https://instagram.com/cunadismo_ilustrado
VITE_TWITTER_URL=https://twitter.com/cunadismo_ilustrado
VITE_FACEBOOK_URL=https://facebook.com/cunadismo.ilustrado

# Configuraciones de desarrollo
VITE_DEBUG_MODE=true
VITE_SHOW_LOGS=true
