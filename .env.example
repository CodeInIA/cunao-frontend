# =================================================================
# Ejemplo de variables de entorno para el FRONTEND (Vite)
# Copia este archivo a `.env` o `.env.local` y reemplaza los valores.
# En Vite las variables públicas deben comenzar por VITE_
# =================================================================

# URL de la API backend (debe incluir /api al final si el backend lo espera)
VITE_API_URL=https://backend.cunadismoilustrado.me/api

# Stripe (clave pública)
VITE_STRIPE_PUBLIC_KEY=pk_test_tu_clave_publica_stripe

# Información de la app
VITE_APP_NAME=Cuñadismo Ilustrado
VITE_APP_DESCRIPTION=La tienda más cuñao de España
VITE_APP_URL=https://www.cunadismoilustrado.me

# Locale / tienda
VITE_CURRENCY=EUR