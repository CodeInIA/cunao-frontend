# Frontend environment variables (Vite).
# Copy to `.env` or `.env.local` and adjust. Only variables prefixed with VITE_
# are exposed to the browser, so never put secrets here.

# Backend API base URL (include the /api suffix). The dev server also proxies /api to this host.
VITE_API_URL=http://localhost:3001/api

# Stripe publishable key (pk_test_... or pk_live_...). Never a secret sk_ key.
VITE_STRIPE_PUBLIC_KEY=pk_test_your_publishable_key

# App metadata (all optional, defaults live in src/config.ts)
VITE_APP_NAME=Cuñadismo Ilustrado
VITE_APP_DESCRIPTION=Camisetas con humor cuñao
VITE_APP_URL=http://localhost:5173
VITE_APP_KEYWORDS=camisetas, humor, cuñadismo
VITE_APP_AUTHOR=Cuñadismo Ilustrado
VITE_CURRENCY=EUR

# Social links (optional)
VITE_INSTAGRAM_URL=https://www.instagram.com/your_account
VITE_TWITTER_URL=https://x.com/your_account
VITE_TIKTOK_URL=https://www.tiktok.com/@your_account

# Domain used to build contact addresses such as info@<domain> (optional)
VITE_DOMAIN=example.com
VITE_EMAIL_DOMAIN=example.com

# Development flags (optional)
VITE_DEBUG_MODE=false
VITE_SHOW_LOGS=false
VITE_SUPPRESS_DEV_WARNINGS=true
